# ── 密钥与凭证（绝对不能入库）──────────────────
.env
.env.local
.feishu.json
*.credentials.yaml

# ── 可重新生成的依赖与构建产物 ────────────────
node_modules/

# ── 运行时数据（含真实记忆内容，属隐私）────────
data/
*.db
*.db-shm
*.db-wal

# ── 贾维斯自己写出的产物（每次运行都变）────────
sandbox/

# ── 上游第三方参考代码（体积大、非本项目产权）──
_ref/

# ── 设计稿大图（7.5MB PNG，不适合进 git）───────
_mockup/*.png
_mockup/ref/
_mockup/user/

# ── 一次性验证脚本（用完即弃，非主链路）────────
_ff.js
_sg.js
_tmp*.js
_probe*.js

# ── 工具会话私有目录 ──────────────────────────
.workbuddy/

# ── 日志与临时文件 ────────────────────────────
*.log
logs/
*.tmp
.DS_Store
Thumbs.db
