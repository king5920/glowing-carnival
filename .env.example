# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。

# ── LLM：火山方舟 Agent Plan 个人版 ─────────────────────────
# 注意两个易错点：
#   1. 端点必须走 /api/plan/v3/（不是 /api/v3/）
#   2. 模型名是 ark-code-latest（不是 doubao-* 系列）
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest

# ── 同花顺 fuyao 金融数据（hithink-finance），请求头 X-api-key ─────
# 申请：https://fuyao.aicubes.cn/admin/   用于涨跌停/炸板历史回填等
FUYAO_API_KEY=your-fuyao-api-key-here
